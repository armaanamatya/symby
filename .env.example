# SymbyAI Environment Variables
# Copy this file to .env and fill in your values
# Usage: cp .env.example .env

# =============================================================
# NVIDIA NIM API (Required for AI-powered features)
# =============================================================
# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# =============================================================
# Semantic Scholar API (Optional - improves rate limits)
# =============================================================
# Get your API key from: https://www.semanticscholar.org/product/api
S2_API_KEY=

# =============================================================
# LLM Provider Keys (Optional - for validation agent)
# =============================================================
# Anthropic API - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API - https://platform.openai.com/
OPENAI_API_KEY=

# =============================================================
# Application Settings
# =============================================================
# Path to S2ORC data directory
DATA_PATH=s2orc_data

# Number of papers to load by default
DEFAULT_PAPERS=50000
